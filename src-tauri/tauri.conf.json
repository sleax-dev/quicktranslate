{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuickTranslate",
  "version": "1.7.2",
  "identifier": "com.quicktranslate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuickTranslate",
        "width": 980,
        "height": 640,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square284x284Logo.png"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Turkish",
          "English"
        ],
        "sidebarImage": "icons/Square310x310Logo.png"
      }
    },
    "category": "Utility",
    "shortDescription": "Translate selected text in any app with a global hotkey",
    "copyright": "© 2026 thesleax · MIT License",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libxdo3"
        ]
      },
      "rpm": {
        "depends": [
          "libxdo"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRTA1QjNFNjIwMTM5MEYKUldRUE9RRmlQbHZnQUpMNWw4Vi9nRXNiTmZHM1gvaTdlL1VjMFlMbG5jcCtyOGRtVFNRMmIxQzkK",
      "endpoints": [
        "https://github.com/sleax-dev/quicktranslate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
