{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuickTranslate",
  "version": "1.2.0",
  "identifier": "com.quicktranslate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuickTranslate",
        "width": 860,
        "height": 580,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square284x284Logo.png"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Turkish",
          "English"
        ],
        "sidebarImage": "icons/Square310x310Logo.png"
      }
    }
  }
}
